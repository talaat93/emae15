vendor/
*.log
.env
config/config.local.php

# Archives de livraison generees localement : ne jamais les versionner,
# elles seraient publiees telles quelles dans public_html par le deploiement.
*.zip

# Journaux techniques des intégrations (jamais versionnés ni déployés)
storage/logs/
# Marqueurs des migrations automatiques : propres à chaque base
storage/.mig_*

# Photos des interventions : données clients, jamais versionnées
storage/uploads/interventions/
storage/pennylane_sync.lock
storage/uploads/devis/
# Photos envoyées par les clients avec leur demande : données personnelles
storage/uploads/demandes/
# Horodatage et verrou des tâches automatiques (includes/automations.php)
storage/.automations_*
storage/.agent_lock
